# Ejemplo de archivo .env para SistBienes Backend
# Copia este archivo como .env y ajusta los valores según tu configuración

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=sistbienes_user
DB_PASSWORD=TU_PASSWORD_SEGURA_AQUI
DB_NAME=sistbienes_db

# MySQL (si usas MySQL en lugar de PostgreSQL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=sistbienes_user
# DB_PASSWORD=TU_PASSWORD_SEGURA_AQUI
# DB_NAME=sistbienes_db

# ============================================
# JWT CONFIGURATION
# ============================================
# Genera un secret key seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TU_SECRET_KEY_MUY_SEGURA_Y_LARGA_AQUI_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=7d

# ============================================
# CORS CONFIGURATION
# ============================================
# URL del frontend en producción
CORS_ORIGIN=https://tu-dominio.com

# Para múltiples orígenes, separa con comas:
# CORS_ORIGIN=https://tu-dominio.com,https://www.tu-dominio.com

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_PATH=./uploads
TEMP_EXCEL_PATH=./temp_excel_exports
TEMP_PDF_PATH=./temp_pdf_exports
MAX_FILE_SIZE=52428800

# ============================================
# EMAIL CONFIGURATION (si aplica)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu-password-de-aplicacion
# SMTP_FROM=noreply@tu-dominio.com

# ============================================
# OTROS
# ============================================
# Zona horaria
TZ=America/Caracas
